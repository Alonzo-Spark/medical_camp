# Frontend build + Nginx (serves React, reverse-proxies the API)
FROM node:20-slim AS build
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
# Same-origin API: the frontend calls /api, proxied by nginx to the backend.
RUN echo "VITE_API_BASE=/api" > .env.production && npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/frontend/dist /srv
