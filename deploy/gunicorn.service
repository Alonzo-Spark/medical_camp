[Unit]
Description=Gunicorn (Medical Camp Django backend)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/medical_camp
# .env is loaded by Django/dotenv at runtime, so no EnvironmentFile needed.
# 3 worker processes, each with 4 threads — threads keep the voicebot's
# background processing alive (the worker process stays up after responding).
ExecStart=/opt/medical_camp/venv/bin/gunicorn \
    --workers 3 \
    --threads 4 \
    --timeout 120 \
    --bind unix:/run/medicalcamp.sock \
    medicalcamp_inventory.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
